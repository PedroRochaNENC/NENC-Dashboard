# ============================================================
# NENC-Dashboard — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# ============================================================

OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# So para chave criada fora de um workspace (a API pede o header anthropic-workspace-id)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
VECTOR_STORE_ID=vs_69e29b46a3508191a9252e8926c96891
PROSODIA_VECTOR_STORE_ID=vs_6a173b89ac108191b57caa99e39d6fc7

# --- WhatsApp API Integration ---
# Em produção via Docker Compose: http://nenc-whatsapp-api:8000
WHATSAPP_API_URL=http://nenc-whatsapp-api:8000

# Chave secreta de integração (deve ser IDÊNTICA à API_KEY definida no .env da API)
WHATSAPP_API_KEY=your_internal_api_key_here

# Caminho do banco de dados SQLite (no container Docker: /app/data/prosodia.db)
NENC_DB_PATH=/app/data/prosodia.db

# Fuso das horas do Resumo do NencBoost (entradas por hora, últimas 24h). A API
# grava a chegada em UTC e o container roda em UTC (padrão: America/Sao_Paulo)
# NENC_TZ=America/Sao_Paulo

# --- Importação da pasta: Jornada e Teste Sensorial (serviço nenc-import-api) ---
# Um token por organização que envia pelo scripts/nenc_enviar.py (os dois
# módulos), com ao menos 32 caracteres: NENC_IMPORT_TOKEN_<id da organização>.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(36))"
# NENC_IMPORT_TOKEN_1=
# Pasta das importações pendentes (padrão: jornada_inbox/ ao lado do banco)
# NENC_IMPORT_INBOX=/app/data/jornada_inbox
# Dias até um lote parado vencer (padrão: 30)
# NENC_IMPORT_TTL_DAYS=30

# --- Teste Sensorial ---
# Tabelas (Parquet) e originais dos projetos, fora do banco; entram no backup
# junto com ele (padrão: sensorial_data/ ao lado do banco)
# NENC_SENSORIAL_DIR=/app/data/sensorial_data

# --- Bootstrapping do Primeiro Usuário Administrador ---
# Preencha estes campos no .env para criar automaticamente o primeiro usuário admin:
NENC_BOOTSTRAP_ORGANIZATION=NENC
NENC_BOOTSTRAP_NAME=Administrador
NENC_BOOTSTRAP_EMAIL=admin@nenc.in
NENC_BOOTSTRAP_PHONE=5511999999999
NENC_BOOTSTRAP_PASSWORD=DefinaSuaSenhaSeguraAqui123!
