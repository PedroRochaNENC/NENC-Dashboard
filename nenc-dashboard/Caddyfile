# ============================================================
# Configuração do Caddy - Reverse Proxy com SSL Automático
# ============================================================

# Dashboard NENC (e a API de importacao da Jornada em /api/jornada)
insights.nenc.in {
    handle /api/jornada/* {
        # O script envia blocos de ate 8 MB.
        request_body {
            max_size 10MB
        }
        reverse_proxy nenc-import-api:8000
    }
    handle {
        reverse_proxy nenc-dashboard:8501
    }
}

# API WhatsApp Prosodia
whatsapp-api.nenc.in {
    reverse_proxy nenc-whatsapp-api:8000
}
